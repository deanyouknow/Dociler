FROM qwen2.5:3b

# ─── System prompt injected at runtime from skills/*.md ─────────────────────
SYSTEM """
<<<SKILLS>>>
"""

# ─── Inference parameters tuned for document compilation tasks ───────────────

# Lower temperature = more factual, less hallucination on document content
PARAMETER temperature 0.2

# Focused sampling — good for consistent, structured output
PARAMETER top_p 0.85
PARAMETER top_k 40

# Active context window.
# 8192 is a safe default for CPU-only mode (~150 MB KV cache).
# Raise to 16384 or 32768 for very long documents — needs more RAM.
PARAMETER num_ctx 8192

# Penalize repetition — important for long summaries and compilations
PARAMETER repeat_penalty 1.1

# Limit response length to avoid runaway outputs
PARAMETER num_predict 4096

# Stop sequences for clean output termination
# </think> catches any stray thinking-block closers from Qwen3
PARAMETER stop "</think>"
PARAMETER stop "<|im_end|>"
PARAMETER stop "<|endoftext|>"
PARAMETER stop "```\n\n"
